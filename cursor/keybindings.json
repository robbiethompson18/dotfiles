// NOTE: Similar config exists at vscode/keybindings.json — update both when making changes
// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+cmd+0",
        "command": "workbench.action.editorLayoutSingle"
    },
    {
        "key": "ctrl+cmd+9",
        "command": "-workbench.action.moveEditorToLastGroup"
    },
    {
        "key": "ctrl+cmd+-",
        "command": "workbench.action.showEditorTab"
    },
    {
        "key": "ctrl+cmd+9",
        "command": "workbench.action.splitEditorRight"
    },
    {
        "key": "cmd+k cmd+\\",
        "command": "-workbench.action.splitEditorRight"
    },
    {
        "key": "ctrl+cmd+=",
        "command": "workbench.action.showMultipleEditorTabs"
    },
    {
        "key": "cmd+i",
        "command": "composerMode.agent"
    },
    {
        "key": "alt+cmd+s",
        "command": "workbench.action.toggleUnifiedSidebarFromKeyboard",
        "when": "cursor.agentIdeUnification.enabled == true && !isAuxiliaryWindowFocusedContext"
    }
]