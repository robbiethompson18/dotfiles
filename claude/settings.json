{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/repos/dotfiles/claude/mods/now-doing:~/repos/dotfiles/claude/mods/pane-status"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Task(*)",
      "WebSearch",
      "WebFetch(domain:*)",
      "Grep(*)",
      "LS(*)",
      "NotebookRead(**)",
      "TodoWrite(*)",
      "ExitPlanMode(*)",
      "Agent(**)",
      "Skill(*)"
    ],
    "deny": [],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repos/dotfiles/bin/pkill-guard-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if [ -n \"$CLAUDE_ENV_FILE\" ] && command -v direnv &>/dev/null; then direnv export bash >> \"$CLAUDE_ENV_FILE\" 2>/dev/null || true; fi'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repos/dotfiles/bin/cc-state hook SessionStart"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repos/dotfiles/bin/cc-state hook StopFailure"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repos/dotfiles/bin/cc-state hook UserPromptSubmit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repos/dotfiles/bin/oom-guard-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "agenttunnel@agenttunnel": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "allow": [
    "*"
  ],
  "autoUpdates": true
}
