#!/bin/bash

set -e

PLIST_NAME="com.robert.agent-reaper.plist"
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SOURCE="$REPO_DIR/$PLIST_NAME"
DEST="$HOME/Library/LaunchAgents/$PLIST_NAME"

mkdir -p "$HOME/Library/LaunchAgents" /tmp/agent-reaper
launchctl unload "$DEST" 2>/dev/null || true
cp "$SOURCE" "$DEST"
launchctl load "$DEST"

echo "Installed and loaded $PLIST_NAME"
echo "Agents can request retirement with: agent-reaper request --reason done"
echo "Check /tmp/agent-reaper/agent-reaper.log for decisions"
