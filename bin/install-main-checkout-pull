#!/bin/bash
# Installs the 5-minute pull of reference-only main checkouts (bin/pull-main-checkouts) as a launchd
# agent. macOS only: the checkouts it keeps current live on the Mac. Not run by install.sh, since a
# machine without those checkouts would just log a skip every 5 minutes.

set -e

if [[ "$OSTYPE" != darwin* ]]; then
    echo "main-checkout-pull is macOS-only; skipping"
    exit 0
fi

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PLIST_NAME="com.robert.main-checkout-pull.plist"
DEST="$HOME/Library/LaunchAgents/$PLIST_NAME"

mkdir -p "$HOME/Library/LaunchAgents"
launchctl unload "$DEST" 2>/dev/null || true
cp "$REPO_DIR/$PLIST_NAME" "$DEST"
launchctl load "$DEST"

echo "Installed and loaded $PLIST_NAME"
echo "Will fast-forward main checkouts every 5 minutes (and on login)"
echo "Check /tmp/main-checkout-pull.log for output; !!! lines are skips and failures"
