#!/usr/bin/env bash
# cc-state — workflow state of the Claude Code session in this iTerm2 pane.
#
#   cc-state coding|experiment|review-bots|review-robbie|intermediate-results|results|quiz|questions|blocked
#                                            set the state
#   cc-state clear                           drop the state
#   cc-state hook <Event>                    called by the hooks in claude/settings.json
#
# Writes the state to ~/.cache/cc-state/<iTerm session uuid>.label until Robbie's next prompt clears
# it. The pane-status mod polls that file and draws a colored banner above the prompt bar.
set -u

[ -n "${ITERM_SESSION_ID:-}" ] || exit 0
mkdir -p "$HOME/.cache/cc-state"
f="$HOME/.cache/cc-state/${ITERM_SESSION_ID#*:}.label"

case "${1:-}" in
  coding | experiment | review-bots | review-robbie | intermediate-results | results | quiz | questions | blocked) echo "$1" >"$f" ;;
  clear) rm -f "$f" ;;
  hook)
    case "${2:-}" in
      SessionStart | UserPromptSubmit) rm -f "$f" ;;
      StopFailure) echo blocked >"$f" ;;
    esac
    ;;
  *)
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
