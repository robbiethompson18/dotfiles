#!/usr/bin/env bash
# cc-state — workflow state of the Claude Code session in this iTerm2 pane.
#
#   cc-state ideating|implementing|review|overnight   set the workflow state
#   cc-state blocked                                   blocked on Robbie, until his next prompt
#   cc-state clear                                     drop the workflow state
#   cc-state hook <Event>                              called by the hooks in claude/settings.json
#
# Writes the label (IDEA, IMPL, REVIEW, NIGHT, BLOCK or nothing) to
# ~/.cache/cc-state/<iTerm session uuid>.label. The pane-status mod polls that file and prefixes the
# session title in the prompt bar with it, because only a mod can rename a session.
set -u

[ -n "${ITERM_SESSION_ID:-}" ] || exit 0
mkdir -p "$HOME/.cache/cc-state"
f="$HOME/.cache/cc-state/${ITERM_SESSION_ID#*:}"

write_label() {
  local label=""
  if [ -e "$f.blocked" ]; then
    label=BLOCK
  else
    case "$(cat "$f.workflow" 2>/dev/null)" in
      ideating) label=IDEA ;;
      implementing) label=IMPL ;;
      review) label=REVIEW ;;
      overnight) label=NIGHT ;;
    esac
  fi
  echo "$label" >"$f.label"
}

case "${1:-}" in
  ideating | implementing | review | overnight)
    echo "$1" >"$f.workflow"
    rm -f "$f.blocked"
    ;;
  blocked) touch "$f.blocked" ;;
  clear) rm -f "$f.workflow" "$f.blocked" ;;
  hook)
    case "${2:-}" in
      SessionStart)
        case "$(jq -r '.source // empty')" in
          startup | clear) rm -f "$f.workflow" "$f.blocked" ;;
        esac
        ;;
      UserPromptSubmit) rm -f "$f.blocked" ;;
      StopFailure) touch "$f.blocked" ;;
    esac
    ;;
  *)
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
write_label
