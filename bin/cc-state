#!/usr/bin/env bash
# cc-state — workflow state of the Claude Code session in this iTerm2 pane.
#
#   cc-state coding|experiment|review-bots|intermediate-results|results|quiz|questions|blocked
#                                            set the state (the model's)
#   cc-state review-robbie "<PR url> +<added>/-<deleted> <what it does>" ["..."...]
#                                            show changes waiting on Robbie's review, one row each, and
#                                            drop the state; the rows outlive later states
#   cc-state reviewed                        drop the review rows once nothing waits on Robbie
#   cc-state mode insta|discovering|implementing
#                                            set Robbie's mode row above the state and drop the state;
#                                            only the /insta, /discover and /go skills run this
#   cc-state ask "<question>" ["<question>"...]
#                                            show non-blocking questions, one row each
#   cc-state ack                             drop the questions once Robbie has answered them
#   cc-state clear                           drop the state, questions and review rows, not the mode
#   cc-state hook <Event>                    called by the hooks in claude/settings.json
#
# Writes the state to ~/.cache/cc-state/<iTerm session uuid>.label, the questions to .question, the
# review rows to .review and the mode to .mode next to it. The mode stacks above the state, and setting it drops the state. Neither clears on a prompt, since a wakeup (task notification, etc.) also fires
# UserPromptSubmit; the model replaces the state itself and drops the questions with `ack`, and every
# prompt reminds it of both. The pane-status mod polls the files and draws colored banners above the
# prompt bar.
set -u

[ -n "${ITERM_SESSION_ID:-}" ] || exit 0
mkdir -p "$HOME/.cache/cc-state"
f="$HOME/.cache/cc-state/${ITERM_SESSION_ID#*:}.label"
q="${f%.label}.question"
m="${f%.label}.mode"
r="${f%.label}.review"

case "${1:-}" in
  coding | experiment | review-bots | intermediate-results | results | quiz | questions | blocked) echo "$1" >"$f" ;;
  review-robbie)
    shift
    # Bare `review-robbie` was the old state; without a link Robbie can't open the change, so refuse it.
    [ $# -gt 0 ] || { sed -n '6,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
    printf '%s\n' "${@//$'\n'/ }" >"$r" && rm -f "$f"
    ;;
  reviewed) rm -f "$r" ;;
  ask)
    shift
    printf '%s\n' "${@//$'\n'/ }" >"$q"
    ;;
  mode)
    case "${2:-}" in
      insta | discovering | implementing) echo "$2" >"$m" && rm -f "$f" ;;
      *) exit 2 ;;
    esac
    ;;
  ack) rm -f "$q" ;;
  clear) rm -f "$f" "$q" "$r" ;;
  hook)
    case "${2:-}" in
      SessionStart)
        # A compacted or resumed session still owns its state, questions and reviews; a fresh one doesn't.
        case "$(jq -r .source)" in compact | resume) ;; *) rm -f "$f" "$q" "$m" "$r" ;; esac
        ;;
      UserPromptSubmit)
        # Hook stdout lands in the model's context.
        # In /insta mode the model makes no tool calls, so the state and question reminders don't apply.
        if [ "$(cat "$m" 2>/dev/null)" = insta ]; then
          echo "Robbie's banner shows INSTA: you are still in /insta mode (no tools, no code). Only /discover or /go ends it; don't run \`cc-state\`."
          exit 0
        fi
        [ -s "$f" ] && echo "Robbie's banner shows your state as \`$(cat "$f")\`. If that is no longer true, run \`cc-state <state>\`."
        if [ -s "$r" ]; then
          echo "Robbie's banner shows these changes waiting on his review:"
          sed 's/^/- /' "$r"
          echo 'Once one is merged, closed or no longer waiting on him, re-run `cc-state review-robbie` with the rest, or `cc-state reviewed` if none are left.'
        fi
        if [ -s "$q" ]; then
          echo "Your non-blocking questions are still in Robbie's banner:"
          sed 's/^/- /' "$q"
          echo 'If this message answers them, acknowledge the answer and run `cc-state ack` (or re-run `cc-state ask` with just the ones still open). If it does not, or the answer is insufficient, leave them up; you are welcome to ask again or sharpen the question.'
        fi
        ;;
      StopFailure) echo blocked >"$f" ;;
    esac
    ;;
  *)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
