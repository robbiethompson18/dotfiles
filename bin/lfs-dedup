#!/usr/bin/python3
"""Make Git LFS working files APFS clones of their .git/lfs objects, so each file's data is stored once.

LFS keeps every object in .git/lfs/objects and git writes a second full copy into the working tree via
the smudge filter, which can't clone. `git lfs dedup` fixes that but refuses to run on a dirty tree and
is undone by any checkout/rebase/pull that rewrites the files, so bin/disk-sweep runs this hourly.

A file is replaced only if it doesn't already share blocks with its object (cheap: compares the
physical offset of the first extent) and its sha256 still equals the LFS oid (i.e. it's unmodified).

Usage: lfs-dedup <repo>...   Prints one summary line per repo.
"""
import ctypes
import fcntl
import hashlib
import os
import struct
import subprocess
import sys

F_LOG2PHYS_EXT = 65
libc = ctypes.CDLL(None, use_errno=True)


def first_extent(path):
    with open(path, "rb") as f:
        buf = struct.pack("=Iqq", 0, 1 << 20, 0)  # struct log2phys {flags, contigbytes, devoffset}
        return struct.unpack("=Iqq", fcntl.fcntl(f.fileno(), F_LOG2PHYS_EXT, buf))[2]


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def dedup(repo):
    listing = subprocess.run(
        ["git", "-C", repo, "lfs", "ls-files", "-l"], capture_output=True, text=True, check=True
    ).stdout
    cloned = cloned_bytes = skipped = 0
    for line in listing.splitlines():
        oid, _, rel = line.split(" ", 2)  # "<oid> <*|-> <path>"; * = checked out, - = pointer only
        path = os.path.join(repo, rel)
        obj = os.path.join(repo, ".git/lfs/objects", oid[:2], oid[2:4], oid)
        try:
            before = os.stat(path)
            if before.st_size == 0 or not os.path.exists(obj) or first_extent(path) == first_extent(obj):
                continue
            if sha256(path) != oid:
                skipped += 1  # modified in the working tree
                continue
            tmp = path + ".lfs-dedup-tmp"
            if libc.clonefile(obj.encode(), tmp.encode(), 0) != 0:
                raise OSError(ctypes.get_errno(), "clonefile failed", obj)
            os.chmod(tmp, before.st_mode & 0o7777)
            os.utime(tmp, ns=(before.st_atime_ns, before.st_mtime_ns))
            if os.stat(path).st_mtime_ns != before.st_mtime_ns:  # written to while we hashed it
                os.unlink(tmp)
                continue
            os.rename(tmp, path)
            cloned += 1
            cloned_bytes += before.st_size
        except OSError as e:
            print(f"{rel}: {e}", file=sys.stderr)
    print(f"{repo}: cloned {cloned} files ({cloned_bytes / 1e9:.2f} GB), skipped {skipped} modified")


for repo in sys.argv[1:]:
    dedup(repo)
