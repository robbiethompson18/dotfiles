# THIS REPO IS PUBLIC. Notes naming real infrastructure (AWS account IDs, work
# hosts, billing accounts) belong in ~/repos/dotfiles-private, which is symlinked
# to ~/.claude/docs by bin/setup-symlinks.sh. claude/.claude/notes/ and claude/projects/
# were purged from history on 2026-09-07; the ignores stop them from drifting back in.
claude/docs/
claude/.claude/notes/
claude/projects/

legacy.zshrc
*.swp
*.swo
*.log
*.env
.zshrc.backup

# Claude plugins - auto-managed runtime state, no need to track
claude/plugins/install-counts-cache.json
claude/plugins/installed_plugins.json
claude/plugins/known_marketplaces.json

# Plugin cache + marketplace fetches - re-fetchable, not worth tracking
claude/plugins/cache/
claude/plugins/marketplaces/

# Skills synced from claude.ai - runtime state keyed by org/user UUID, regenerated per login
claude/skills/synced/

# Claude Code soft-deletes bundled skills here when it migrates them to the plugin namespace
claude/skills/.trash/

# Codex rewrites this in place with per-repo trust entries, hook hashes and TUI counters, so it is
# machine-local; setup-symlinks.sh still links it into both Codex roots on the same machine.
codex/config.toml
